# Configuração PÚBLICA do navegador. Tudo que começa com VITE_ vai para o bundle e é visível a qualquer
# visitante: NUNCA coloque aqui chave de serviço (service_role / sb_secret_), senha, token de acesso ou
# endereço de banco. O build recusa variáveis VITE_* com cara de segredo.
# Copie para .env.local (ignorado pelo Git) quando precisar; no Cloudflare Pages use o painel
# (Settings > Variables and secrets), em Production e também em Preview.

# --- Modo 1: demonstração (padrão; só desenvolvimento) -------------------------------------------------
# Em máquina que não seja local (hospedagem), a demonstração é RECUSADA, a menos que
# VITE_ALLOW_PUBLIC_DEMO=true seja definido de propósito.
VITE_APP_MODE=demo

# --- Modo 2: Supabase local descartável (desenvolvimento e testes) -------------------------------------
# VITE_APP_MODE=local
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   (npx supabase status)

# --- Modo 3: hospedado (Cloudflare Pages + Supabase) ---------------------------------------------------
# Todas as quatro são obrigatórias; faltando ou errando qualquer uma, o build falha e o site não abre
# (nunca cai na demonstração). Endereço: https://<referência-do-projeto>.supabase.co, sem barra final.
# Chave: a PUBLICÁVEL (sb_publishable_...), nunca a secreta. VITE_APP_ENV: testes ou producao.
# VITE_APP_MODE=hosted
# VITE_SUPABASE_URL=https://<referência-do-projeto>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_APP_ENV=testes
